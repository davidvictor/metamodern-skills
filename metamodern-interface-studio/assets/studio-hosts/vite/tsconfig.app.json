{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "paths": {
      "@studio/icon-glyphs": ["./.studio-generated/icon-glyphs.ts"],
      "@studio/icon-profile": ["./.studio-generated/icon-profile.ts"],
      "@/*": ["./src/*"],
      "@studio/design-ui": ["./src/studio/design-ui/api.ts"],
      "@studio/kit": ["./src/kit/index.ts"],
      "@studio/workspace": ["./src/studio/workspace/api.ts"],
      "@studio/library": ["./src/studio/library/api.ts"]
    }
  },
  "include": ["src", "example"]
}
